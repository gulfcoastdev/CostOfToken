# --- Database (Supabase Postgres) ---------------------------------------
# Use the *connection pooler* URL (port 6543) for serverless on Vercel.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Public site URL (SEO) -----------------------------------------------
# Canonical origin, used for canonical tags, Open Graph URLs, sitemap entries
# and structured data. No trailing slash. Without this, URLs fall back to
# https://costoftoken.com, which will be wrong on a preview deployment.
NEXT_PUBLIC_SITE_URL="https://costoftoken.com"

# --- Cron protection ------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# --- Rate limiting --------------------------------------------------------
# Requests/hour for anonymous callers (per IP).
RATE_LIMIT_ANON_PER_HOUR="60"

# --- Optional provider credentials ---------------------------------------
# Only needed for extractors that read an authenticated models endpoint.
# Without these the provider falls back to the curated catalog.
XAI_API_KEY=""
