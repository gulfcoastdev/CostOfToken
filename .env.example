# --- Database (Supabase Postgres) ---------------------------------------
# Use the *connection pooler* URL (port 6543) for serverless on Vercel.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler"
# Supabase dashboard -> Connect (top of page) -> Direct -> Transaction pooler.
# Username is postgres.<project-ref>, NOT plain postgres.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# If you add Supabase through the Vercel marketplace integration instead, it
# injects POSTGRES_URL automatically and you can leave DATABASE_URL unset --
# the app falls back to POSTGRES_URL / POSTGRES_PRISMA_URL / SUPABASE_DB_URL.

# --- Public site URL (SEO) -----------------------------------------------
# Canonical origin, used for canonical tags, Open Graph URLs, sitemap entries
# and structured data. No trailing slash. Without this, URLs fall back to
# https://costoftoken.com, which will be wrong on a preview deployment.
NEXT_PUBLIC_SITE_URL="https://costoftoken.com"

# --- Analytics (optional) -------------------------------------------------
# Google Analytics 4 measurement id. Not a secret — it ships in the page
# source. Only loaded in production builds, so local development and preview
# deployments stay out of the reports.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- Cron protection ------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# --- Rate limiting --------------------------------------------------------
# Requests/hour for anonymous callers (per IP).
RATE_LIMIT_ANON_PER_HOUR="60"

# Site-wide ceiling across every caller, per hour. A backstop against abuse
# spread over many addresses, which a per-IP limit cannot see. On a free plan
# the risk is the project being paused for exceeding fair use, not a bill.
# Generous by design; legitimate traffic should never approach it.
RATE_LIMIT_GLOBAL_PER_HOUR="20000"

# --- Optional provider credentials ---------------------------------------
# Only needed for extractors that read an authenticated models endpoint.
# Without these the provider falls back to the curated catalog.
XAI_API_KEY=""

# --- Price fault alerts (optional) -----------------------------------------
# Both absent means silence: the pipeline behaves exactly as it does today and
# sends nothing, so a fresh clone and every local run stay quiet.
# Set in the Vercel project so the daily cron can report blocked providers,
# failures, and prices that moved again within 24h of their last change.
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
# Optional; defaults to alerts@costoftoken.com
ALERT_EMAIL_FROM=""
